# =============================================================================
# CampX AI - configuration template.  COPY to ".env" (never commit ".env").
# Everything below is a PLACEHOLDER. No real secrets belong in this file.
# Run  scripts\setup.ps1  to create .env and a random APP_SECRET_KEY for you.
# =============================================================================

# --- Application -------------------------------------------------------------
# development | production.  Production enables Secure cookies, __Host- cookie
# names and strict startup checks (HTTPS origin, secret length).
APP_ENV=development

# REQUIRED. Random string, at least 32 characters. Used to encrypt upstream
# CampX session data at rest and to sign CSRF tokens. Generate with:
#   python scripts/generate_secret.py
APP_SECRET_KEY=

# Comma-separated list of exact browser origins allowed to call the API (CORS,
# CSRF origin check). Must be https:// in production.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# SQLite file for sessions + imported data (relative paths are relative to the
# project root).
DATABASE_PATH=backend/data/campx_ai.db

# Website session lifetime (hours). The session also never outlives the CampX
# token expiry when CampX reports one.
SESSION_TTL_HOURS=8
MAX_SESSIONS_PER_USER=5

# Optional override. Leave empty to use: Secure = (APP_ENV == production).
COOKIE_SECURE=

# Timezone used to decide what "today" is for the timetable.
APP_TIMEZONE=Asia/Kolkata

# --- Data source -------------------------------------------------------------
# campx    = live CampX data only (errors if an endpoint is not configured)
# imported = only JSON you imported yourself (Settings page)
# auto     = try live CampX if configured, fall back to imported JSON
DATA_SOURCE=auto

# --- CampX upstream ----------------------------------------------------------
CAMPX_API_BASE=https://api.campx.in
CAMPX_WEB_ORIGIN=https://gnitc.campx.in
CAMPX_LOGIN_PATH=/auth-server/auth-v2/login
CAMPX_PLATFORM_ID=campx
CAMPX_TENANT_ID=gnitc

# REQUIRED for live login. The value of the "X-Campx-Client" header sent by the
# official CampX web app. NOT a personal secret, but do not invent it.
# See README section "Finding X-Campx-Client". Login returns 503 until set.
CAMPX_CLIENT_HEADER_VALUE=

# How our backend authenticates follow-up CampX requests. UNVERIFIED - confirm
# in Chrome DevTools (steps_for_chatgpt.md section 11).
#   cookie  = replay the cookies CampX set at login (campx_session_key, ...)
#   bearer  = Authorization: Bearer <session token>
#   header  = <CAMPX_TOKEN_HEADER>: <session token>
# Combine with commas, e.g. "cookie,bearer".
CAMPX_AUTH_MODE=cookie
CAMPX_TOKEN_HEADER=
CAMPX_COOKIE_NAMES=campx_session_key,campx_tenant,campx_institution

# Live data endpoints (path only, optional "?query"). Empty = not configured.
# The timetable path below was OBSERVED on CampX but is NOT verified to work.
CAMPX_PROFILE_PATH=
CAMPX_TIMETABLE_PATH=/student-api/classroom-timetables
CAMPX_ATTENDANCE_PATH=
CAMPX_SUBJECTS_PATH=

# --- Safety limits -----------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=15
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
MAX_IMPORT_BYTES=262144

# --- Admin (optional) --------------------------------------------------------
# Leave empty to DISABLE /api/admin/*. If set, use 32+ random characters.
ADMIN_TOKEN=
